rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'sagomaskan@outlook.com';
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.price is number && data.price >= 0 && data.price <= 100000;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() > 0 && data.customerEmail.size() <= 160
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 500000
        && data.status is string && data.status in ['Mottagen', 'Packas', 'Skickad', 'Avbruten', 'new', 'shipped', 'cancelled', 'completed', 'processing'];
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    function isValidDiscount(data) {
      return data.code is string && data.code.size() >= 2 && data.code.size() <= 50
        && data.type is string && data.type in ['percent', 'fixed']
        && data.value is number && data.value >= 0;
    }

    function isValidCustomer(data, customerId) {
      return data.keys().hasAll(['id', 'name', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'email', 'phone', 'address', 'zip', 'city',
          'favorites', 'favoritesCount', 'newsletterSubscribed',
          'newsletterUpdatedAt', 'createdAt', 'lastLoginAt',
          'previousLoginAt', 'updatedAt', 'activityLog'
        ])
        && data.id is string && data.id == customerId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('zip' in data) || (data.zip is string && data.zip.size() <= 20))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 200))
        && (!('favoritesCount' in data) || (data.favoritesCount is number && data.favoritesCount >= 0 && data.favoritesCount <= 200))
        && (!('newsletterSubscribed' in data) || (data.newsletterSubscribed is bool))
        && (!('newsletterUpdatedAt' in data) || (data.newsletterUpdatedAt is string && data.newsletterUpdatedAt.size() <= 64))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64))
        && (!('previousLoginAt' in data) || (data.previousLoginAt is string && data.previousLoginAt.size() <= 64))
        && (!('activityLog' in data) || (data.activityLog is list && data.activityLog.size() <= 25));
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && incoming().stock is number
          && incoming().stock >= 0
          && incoming().stock < existing().stock
        )
      );
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (
          existing().status in ['new', 'Mottagen']
          && incoming().status == 'cancelled'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt'])
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update, delete: if isValidId(messageId) && isAdmin();
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(customerId) && isValidCustomer(incoming(), customerId);
      allow update: if isValidId(customerId) && isValidCustomer(incoming(), customerId) && (
        isAdmin() ||
        (
          incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'email', 'phone', 'address', 'zip', 'city',
            'favorites', 'favoritesCount', 'newsletterSubscribed',
            'newsletterUpdatedAt', 'lastLoginAt', 'previousLoginAt',
            'updatedAt', 'activityLog'
          ])
        )
      );
      allow delete: if isValidId(customerId) && isAdmin();
    }

    match /discounts/{discountId} {
      allow read: if true;
      allow create, update: if isValidId(discountId) && isAdmin() && isValidDiscount(incoming());
      allow delete: if isValidId(discountId) && isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}
