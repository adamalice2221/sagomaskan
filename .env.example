# RESEND_API_KEY: API-nyckel från Resend (konfigureras i Secrets, ej i frontend).
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: Avsändaradress för ordermail (t.ex. "Sagomaskan <order@dindoman.se>").
# För test med eget konto kan "Sagomaskan <onboarding@resend.dev>" användas.
RESEND_FROM_EMAIL="Sagomaskan <onboarding@resend.dev>"

# SWISH_NUMBER / SWISH_RECIPIENT_NAME: Valfri server-fallback om Swish inte angetts i Adminpanelen.
SWISH_NUMBER=""
SWISH_RECIPIENT_NAME="Sagomaskan"

# STORE_OWNER_EMAIL: Butiksägarens e-post för svar-till (Reply-To) och valfri orderkopia.
STORE_OWNER_EMAIL="sagomaskan@outlook.com"

# APP_URL: Webbshoppens publika URL (injiceras automatiskt i AI Studio / Cloud Run).
APP_URL="MY_APP_URL"
